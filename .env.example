# Local: SQLite is automatic when DATABASE_URL is absent.
# Vercel: use your provider's pooled PostgreSQL connection string.
DATABASE_URL=
# Used only by npm run db:setup to create the first administrator.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Local-only sample users; never enabled in production.
DEMO_SEED=1
PORT=3001
